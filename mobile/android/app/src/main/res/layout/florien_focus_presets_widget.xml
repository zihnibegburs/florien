<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/florien_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/focus_presets_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_focus_how_long"
        android:textColor="#29262D"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/focus_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/florien_widget_soft_action"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/widget_min_5"
            android:textColor="#29262D"
            android:textStyle="bold" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/focus_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/florien_widget_soft_action"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/widget_min_10"
            android:textColor="#29262D"
            android:textStyle="bold" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/focus_15"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/florien_widget_primary"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/widget_min_15"
            android:textColor="#29262D"
            android:textStyle="bold" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/focus_30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/florien_widget_soft_action"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/widget_min_30"
            android:textColor="#29262D"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
