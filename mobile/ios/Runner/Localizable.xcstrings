    "api.error.invalid_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Florien configuration is missing. Open the app once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Florien yapılandırması eksik. Uygulamayı bir kez aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la configuración de Florien. Abre la app una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration Florien manquante. Ouvrez l'app une fois."
