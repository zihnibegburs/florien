            "value": "Diz o nome da tarefa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク名を言って。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 이름을 말해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出任务名称。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل اسم المهمة."
          }
        }
      }
    },
    "intent.add_task.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
