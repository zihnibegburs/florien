    "widget.desc.daily": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün tamamlanmamış görevlerini gör."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today’s open tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira las tareas abiertas de hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die offenen Aufgaben von heute an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois tes tâches ouvertes du jour."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê as tarefas em aberto de hoje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の未完了タスクを見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 끝나지 않은 할 일을 봐요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今天尚未完成的任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض مهام اليوم غير المكتملة."
          }
        }
      }
    },
    "widget.desc.todo": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanmamış To-do görevlerini gör ve ekle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See and add open To-do tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira y añade To-dos pendientes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh offene To-dos und füge welche hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois et ajoute tes To-dos ouverts."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê e adiciona To-dos em aberto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了のTo-doを見て追加する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝나지 않은 To-do를 보고 추가해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看并添加未完成的待办。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض To-do غير المكتمل وأضف مهامًا."
          }
        }
      }
    },
    "widget.desc.focus15": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek dokunuşla 15 dakikalık odak turu başlat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a 15-minute focus round with one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza 15 minutos de foco con un toque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit einem Tipp 15 Minuten Fokus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance 15 minutes de focus d’un tap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
