      }
    },
    "intent.add_task.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Florien eine neue Aufgabe hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a new task to Florien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una nueva tarea a Florien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une nouvelle tâche à Florien."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Florien'ya yeni bir görev ekler."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma nova tarefa ao Florien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Florienに新しいタスクを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Florien에 새 할 일을 추가해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Florien 添加一项新任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف مهمة جديدة إلى Florien."
          }
        }
      }
    },
