        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가하지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加任务。稍后再试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إضافة المهمة. حاول لاحقًا."
          }
        }
      }
