    "intent.add_task.parameter.prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du hinzufügen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to add?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres añadir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que voulez-vous ajouter ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne eklemek istiyorsun?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que queres adicionar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を追加する？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 추가할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想添加什么？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن تضيف؟"
          }
        }
      }
    },
    "intent.add_task.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag den Aufgabennamen."
          }
