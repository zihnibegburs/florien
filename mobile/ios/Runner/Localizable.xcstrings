    "widget.desc.quick_add": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aklına geleni hızlıca To-do listene ekle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly add what’s on your mind to your To-do list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade rápido lo que se te ocurra a tu To-do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge schnell hinzu, was dir einfällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute vite ce qui te passe par la tête à tes To-dos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona depressa o que te ocorreu à lista To-do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いついたことをすぐTo-doに足す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠오른 걸 바로 To-do에 넣어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把刚想到的事快速加入待办。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ما يخطر ببالك بسرعة إلى قائمة To-do."
          }
        }
      }
    },
    "widget.desc.quick_actions": {
      "extractionState": "manual",
      "localizations": {
