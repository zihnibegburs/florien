        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ajouter la tâche."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev eklenemedi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar a tarefa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加できなかったよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가하지 못했어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إضافة المهمة."
          }
        }
      }
    },
    "intent.add_task.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, \"%@\" wurde hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done, added \"%@\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo, se añadió \"%@\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est fait, « %@ » a été ajouté."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam, \"%@\" görevini ekledim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto, adicionei \"%@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できたよ。「%@」を追加した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료, \"%@\"을(를) 추가했어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好了，已添加“%@”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم، أضفت \"%@\"."
          }
        }
      }
    },
    "intent.add_task.error.retry": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabe konnte nicht hinzugefügt werden. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not add task. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir la tarea. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ajouter la tâche. Réessayez plus tard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev eklenemedi. Biraz sonra tekrar dene."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar a tarefa. Tenta mais tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加できなかった。あとでまた試して。"
